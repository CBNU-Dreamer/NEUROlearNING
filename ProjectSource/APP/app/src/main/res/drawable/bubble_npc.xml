<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 말풍선 몸통 -->
    <item
        android:left="8dp"
        android:top="4dp"
        android:right="8dp"
        android:bottom="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#E0F7FA"/>         <!-- 배경색 -->
            <corners android:radius="12dp"/>         <!-- 둥근 모서리 -->
        </shape>
    </item>

    <!-- 말풍선 꼬리 (작은 정사각형을 45도 회전) -->
    <item android:gravity="bottom|left">
        <rotate
            android:fromDegrees="45"
            android:pivotX="0%"
            android:pivotY="100%">
            <shape android:shape="rectangle">
                <size
                    android:width="16dp"
                    android:height="16dp"/>
                <solid android:color="#E0F7FA"/>
            </shape>
        </rotate>
    </item>

</layer-list>
