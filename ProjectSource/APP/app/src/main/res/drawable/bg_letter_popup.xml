<!-- res/drawable/bg_letter_popup.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 벼룩시장에 파는 오래된 편지지 같은 연한 크림색 -->
    <solid android:color="#FFF9E6"/>
    <!-- 점선 테두리 넣어 종이 느낌 강조 -->
    <stroke
        android:width="2dp"
        android:color="#D2B48C"
        android:dashWidth="6dp"
        android:dashGap="4dp"/>
    <corners android:radius="4dp"/>
    <padding
        android:left="16dp"
        android:top="16dp"
        android:right="16dp"
        android:bottom="16dp"/>
</shape>
