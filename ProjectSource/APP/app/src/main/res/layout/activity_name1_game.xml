<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F0"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- 게임 타이틀 -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이웃 이름 기억 게임"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="12dp" />

        <!-- 지시 문구 -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이웃의 이름을 기억해볼까요?"
            android:textSize="16sp"
            android:textColor="#333333"
            android:layout_marginBottom="24dp" />

        <!-- 6명의 이웃 캐릭터 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- 한 줄에 두 명씩 3줄 구성 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:contentDescription="이웃 이미지: 정새연"
                        android:src="@drawable/neigh1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#FFD1A2"
                        android:padding="6dp"
                        android:text="정새연"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:contentDescription="이름: 정새연" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:contentDescription="이웃 이미지: 카구야"
                        android:src="@drawable/neigh2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#FFD1A2"
                        android:padding="6dp"
                        android:text="카구야"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:contentDescription="이름: 카구야" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:contentDescription="이웃 이미지: 배수연"
                        android:src="@drawable/neigh3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#FFD1A2"
                        android:padding="6dp"
                        android:text="배수연"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:contentDescription="이름: 배수연" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:contentDescription="이웃 이미지: 야마다"
                        android:src="@drawable/neigh4" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#FFD1A2"
                        android:padding="6dp"
                        android:text="야마다"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:contentDescription="이름: 야마다" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:contentDescription="이웃 이미지: 에렌"
                        android:src="@drawable/neigh5" />

                    <TextView
                        android:layout_width="55dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#FFD1A2"
                        android:contentDescription="이름: 에렌"
                        android:gravity="center"
                        android:padding="6dp"
                        android:text="에렌"
                        android:textColor="#000000"
                        android:textSize="16sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:contentDescription="이웃 이미지: 배새연"
                        android:src="@drawable/neigh6" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#FFD1A2"
                        android:padding="6dp"
                        android:text="배새연"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:contentDescription="이름: 배새연" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 확인 버튼 -->
        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="124dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#F57C00"
            android:padding="12dp"
            android:text="확인"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            app:strokeColor="#000000"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>
