<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F0"
    android:padding="24dp">

    <!-- 게임 타이틀 -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="정류장 개수 기억 게임"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- NPC 대사 - 중앙 크게 -->
    <TextView
        android:id="@+id/tvNpcDialogue"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginTop="40dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/ic_rounded"
        android:backgroundTint="#FFE0B2"
        android:gravity="center"
        android:padding="20dp"
        android:text="저는 신설동에서 내려야 해요!"
        android:textColor="#000000"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 버스 노선표 보기 버튼 -->
    <Button
        android:id="@+id/btnShowBusLine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:backgroundTint="#F57C00"
        android:padding="16dp"
        android:text="버스 노선표 보기"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvNpcDialogue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 버스 노선표 컨테이너 (처음에는 숨김) -->
    <LinearLayout
        android:id="@+id/busLineContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="8dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvNpcDialogue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚌 버스 노선표"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvBusLineDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ic_rounded"
            android:backgroundTint="#FFD1A2"
            android:gravity="center"
            android:padding="16dp"
            android:text="서울역 → 시청 → 종로3가 → 동대문 → 신설동 → 청량리"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 답변 버튼들 (하단) -->
    <LinearLayout
        android:id="@+id/answerButtonsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="몇 정류장 뒤인가요?"
            android:textSize="16sp"
            android:textColor="#666666"
            android:layout_marginBottom="16dp" />

        <!-- 첫 번째 줄 (1, 2, 3) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn1"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="1"
                android:textSize="24sp"
                android:textStyle="bold"
                android:backgroundTint="#FFD1A2"
                android:layout_marginEnd="16dp" />

            <Button
                android:id="@+id/btn2"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="2"
                android:textSize="24sp"
                android:textStyle="bold"
                android:backgroundTint="#FFD1A2"
                android:layout_marginEnd="16dp" />

            <Button
                android:id="@+id/btn3"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="3"
                android:textSize="24sp"
                android:textStyle="bold"
                android:backgroundTint="#FFD1A2" />
        </LinearLayout>

        <!-- 두 번째 줄 (4, 5, 6) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn4"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="4"
                android:textSize="24sp"
                android:textStyle="bold"
                android:backgroundTint="#FFD1A2"
                android:layout_marginEnd="16dp" />

            <Button
                android:id="@+id/btn5"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="5"
                android:textSize="24sp"
                android:textStyle="bold"
                android:backgroundTint="#FFD1A2"
                android:layout_marginEnd="16dp" />

            <Button
                android:id="@+id/btn6"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="6"
                android:textSize="24sp"
                android:textStyle="bold"
                android:backgroundTint="#FFD1A2" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>