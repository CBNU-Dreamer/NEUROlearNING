<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F0"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- NPC 대화창 -->
    <TextView
        android:id="@+id/tvNpcDialog"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/ic_rounded"
        android:padding="20dp"
        android:text="불고기 버거 한 번 드셔보실래요?\n제가 도와드릴게요!\n같이 주문해봐요!"
        android:textColor="#000000"
        android:textSize="20sp" />

    <!-- 키오스크 이미지 -->
    <ImageView
        android:id="@+id/ivKioskImage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="centerInside"
        android:src="@drawable/neighbor2"
        app:srcCompat="@drawable/ic_rsp_paper" />

    <!-- 게임 시작 버튼 -->

    <Button
        android:id="@+id/buttonCreateAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#F57C00"
        android:text="주문 도전하기"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editTextDisease"
        app:strokeWidth="1dp" />
</LinearLayout>
