<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F0"
    android:padding="16dp">

    <!-- 상단 가이드라인 (화면의 2%) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.02" />

    <!-- NPC 이름 박스 하단 가이드라인 (화면의 10%) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineNameBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.10" />

    <!-- 대화창 하단 가이드라인 (화면의 38%) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineDialogBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.30" />

    <!-- 버튼 상단 가이드라인 (화면의 85%) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineButtonTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.85" />

    <!-- [1] NPC 이름 박스 -->
    <TextView
        android:id="@+id/tvNpcName"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/ic_rounded"
        android:backgroundTint="#FFE0B2"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="편의점 직원 배수연"
        android:textColor="#000000"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/guidelineTop"
        app:layout_constraintBottom_toBottomOf="@id/guidelineNameBottom"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- [2] NPC 대화창 + 음성 버튼 영역 -->
    <FrameLayout
        android:id="@+id/dialogFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvNpcName"
        app:layout_constraintBottom_toTopOf="@id/guidelineDialogBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 대화창 -->
        <TextView
            android:id="@+id/tvNpcDialog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/ic_rounded"
            android:padding="20dp"
            android:text="정말 대단해요!\n모든 문제를 잘 풀었어요!\n다음에 또 만나요 :)"
            android:textColor="#000000"
            android:textSize="18sp"
            android:gravity="center" />

        <!-- 음성 버튼: 오른쪽 상단에 배치 -->
        <ImageButton
            android:id="@+id/btnPlayNpcDialog"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:backgroundTint="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Play Voice"
            android:padding="4dp"
            android:src="@android:drawable/ic_btn_speak_now" />
    </FrameLayout>

    <!-- [3] NPC 이미지 - 적응형 크기 -->
    <ImageView
        android:id="@+id/ivEndImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:src="@drawable/neighbor1"
        app:layout_constraintTop_toBottomOf="@id/dialogFrame"
        app:layout_constraintBottom_toTopOf="@id/btnEnd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="1:1" />

    <!-- [4] 종료 버튼 - 더 크게! -->
    <Button
        android:id="@+id/btnEnd"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginVertical="12dp"
        android:backgroundTint="#F57C00"
        android:text="다음에 또 만나요!"
        android:textSize="25sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:strokeColor="#000000"
        app:strokeWidth="2dp"
        app:layout_constraintTop_toTopOf="@id/guidelineButtonTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>