<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F0"
    android:orientation="vertical"
    android:padding="8dp"
    tools:context=".ui.CrossWordGameActivity">

    <!-- 헤더 -->

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:text="십자말 풀이 게임"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- 서브타이틀 -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="4dp"
        android:text="편의점에서 어떤 것들을 사볼까?"
        android:textSize="16sp" />

    <!-- 퍼즐 그리드 표시 영역 -->
    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:alignmentMode="alignMargins"
        android:background="#E3F2FD"
        android:columnCount="8"
        android:padding="4dp"
        android:rowCount="8" />

    <!-- 입력 및 힌트 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E1F5FE"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/ic_circle_border"
            android:padding="8dp"
            android:text="9"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAnswer"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#3F51B5"
            android:gravity="center"
            android:inputType="text"
            android:textColor="#000000"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="힌트가 여기에 표시됩니다."
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/buttonCreateAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#F57C00"
        android:text="정답 확인"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editTextDisease"
        app:strokeColor="#000000"
        app:strokeWidth="1dp" />

    <!-- 확인 버튼 -->

</LinearLayout>
